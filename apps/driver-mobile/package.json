{
  "name": "driver-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/update-ip.js && NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client",
    "start:offline": "node scripts/update-ip.js && NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --offline",
    "android": "node scripts/update-ip.js && expo run:android",
    "ios": "node scripts/update-ip.js && expo run:ios",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^20.3.0",
    "@react-native-firebase/messaging": "^20.3.0",
    "@react-native/virtualized-lists": "0.83.6",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-camera": "~55.0.21",
    "expo-constants": "~55.0.17",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.12",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "nativewind": "^4.0.36",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.7.4"
  },
  "overrides": {
    "react-native-reanimated": "4.2.1",
    "expo-font": "~55.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/config-plugins": "^55.0.11",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "prettier": "^3.2.5",
    "tailwindcss": "3.3.5",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  }
}
