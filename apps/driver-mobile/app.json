{
  "expo": {
    "name": "Driver App",
    "slug": "driver-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dispatch.drivermobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Required for job tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Required for background job tracking.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1d4ed8"
      },
      "package": "com.dispatch.drivermobile",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan parcel QR codes at pickup and capture proof-of-delivery photos."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-asset",
      "./plugins/withAutofillHighlight",
      "./plugins/withShortCxxPaths"
    ],
    "scheme": "driver-mobile",
    "experiments": {
      "typedRoutes": true
    }
  }
}
