{
  "extends": "./tsconfig.expo-base.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "../..",
    "paths": {
      "@components/*": ["apps/driver-mobile/src/components/*"],
      "@screens/*": ["apps/driver-mobile/src/screens/*"],
      "@services/*": ["apps/driver-mobile/src/services/*"],
      "@hooks/*": ["apps/driver-mobile/src/hooks/*"],
      "@contexts/*": ["apps/driver-mobile/src/contexts/*"],
      "@navigation/*": ["apps/driver-mobile/src/navigation/*"],
      "@constants/*": ["apps/driver-mobile/src/constants/*"],
      "@theme": ["apps/driver-mobile/src/theme"],
      "@theme/*": ["apps/driver-mobile/src/theme/*"],
      "@types/*": ["apps/driver-mobile/src/types/*"],
      "@utils/*": ["apps/driver-mobile/src/utils/*"],
      "@dispatch/shared/domain": [
        "libs/shared/domain/src/index.ts"
      ],
      "@dispatch/shared/contracts": [
        "libs/shared/contracts/src/index.ts"
      ],
      "@dispatch/shared/api-client": [
        "libs/shared/api-client/src/index.ts"
      ]
    },
    "jsx": "react-native"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "nativewind-env.d.ts"
  ]
}