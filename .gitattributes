* text=auto

# Linux container entrypoints must keep LF line endings on every host OS.
*.sh text eol=lf

# Keep container and config files stable across Windows, macOS, and Linux.
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.json text eol=lf

# Windows-native scripts should use CRLF if added later.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
