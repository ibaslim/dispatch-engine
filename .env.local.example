# Database
DATABASE_URL=postgresql+asyncpg://dispatch:dispatch@localhost:5432/dispatch_dev
DATABASE_TEST_URL=postgresql+asyncpg://dispatch:dispatch@localhost:5432/dispatch_test

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=changeme-generate-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application URLs
DISPATCHER_WEB_BASE_URL=http://localhost:4200
TRACKING_WEB_BASE_URL=http://localhost:4300
API_BASE_URL=http://localhost:8000

# Google Maps Platform (browser key; restrict it to the web app domains)
GOOGLE_MAPS_API_KEY=
# Recommended: a server-restricted key with Places API (New) and Routes API enabled.
GOOGLE_MAPS_SERVER_API_KEY=

# Pusher Channels (create an app at https://dashboard.pusher.com/)
# PUSHER_KEY and PUSHER_CLUSTER are exposed through the browser-safe runtime
# config endpoint. PUSHER_SECRET always remains server-side.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

FIREBASE_CREDENTIALS_JSON={"type": "","project_id": "","private_key_id": "","private_key": "","client_email": "","client_id": "","auth_uri": "https://accounts.google.com/o/oauth2/auth","token_uri": "https://oauth2.googleapis.com/token","auth_provider_x509_cert_url": "","client_x509_cert_url": "","universe_domain": "googleapis.com"}


# Mail (Mailpit for local/stage)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@dispatch.local
MAIL_STARTTLS=false
MAIL_SSL=false

# Platform admin seed (auto-created on first API boot)
PLATFORM_ADMIN_EMAIL=admin@dispatch.local
PLATFORM_ADMIN_PASSWORD=Admin123!
PLATFORM_ADMIN_NAME=Platform Admin

# Firebase (FCM)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Feature flags
FEATURE_MULTI_STORE=true

# Driver location tracking
#DRIVER_LOCATION_PUSH_INTERVAL_SECONDS is used to calculate grace period (n x DRIVER_LOCATION_PUSH_INTERVAL_SECONDS) incase driver loses connection before setting him offlne
DRIVER_LOCATION_PUSH_INTERVAL_SECONDS=5
EXPO_PUBLIC_DRIVER_LOCATION_PUSH_INTERVAL_SECONDS=5
DRIVER_LOCATION_FLUSH_INTERVAL_SECONDS=300
DRIVER_LOCATION_RETENTION_DAYS=7
DRIVER_LOCATION_ACTIVE_ORDER_NEGATIVE_CACHE_SECONDS=300

